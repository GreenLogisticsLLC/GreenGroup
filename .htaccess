# Clean URLs for legal pages on greengrouplogistics.com (Apache / cPanel)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect extensionless URLs to real files so relative CSS/JS/images resolve correctly
  RewriteRule ^privacy-policy/?$ /privacy-policy.html [R=301,L]
  RewriteRule ^terms/?$ /terms.html [R=301,L]
</IfModule>
